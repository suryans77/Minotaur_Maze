# Environment for docker-compose.elk.yml.
#
#   cp .env.example .env    # then fill in every value below
#
# .env is git-ignored. Never commit real values. These secrets will later
# live in Ansible Vault at ansible/group_vars/all/vault.yml (SRS FR-D-20);
# until then, .env is the only place they exist.
#
# Passwords: at least 16 characters of [A-Za-z0-9_-]. Generate with:
#   openssl rand -hex 24
# Compose refuses to start if any required value is empty.

# Password of the built-in `elastic` superuser. Also your Kibana login.
# Only applied when the Elasticsearch data volume is first created; changing it
# afterwards has no effect (see elk/README.md).
ELASTIC_PASSWORD=

# Password of the built-in `kibana_system` user that Kibana uses to talk to
# Elasticsearch. Set by the `setup` service on every start.
KIBANA_SYSTEM_PASSWORD=

# Password of `logstash_internal`, the write-only user Logstash indexes with.
# Created by the `setup` service on every start.
LOGSTASH_INTERNAL_PASSWORD=

# Kibana encrypted saved objects key (alerting rules, SRS §8.3).
# At least 32 characters. Generate with:  openssl rand -hex 32
# Keep it stable: changing it makes existing encrypted saved objects unreadable.
KIBANA_ENCRYPTION_KEY=

# Kibana session encryption key (xpack.security.encryptionKey). Keeps users
# logged in across Kibana restarts. Use a different value from the key above.
# At least 32 characters. Generate locally with:  openssl rand -hex 32
# Keep it stable: changing it logs out every active session.
KIBANA_SECURITY_ENCRYPTION_KEY=
